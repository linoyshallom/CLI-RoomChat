# VITE_BACKEND_URL: base URL of the FastAPI backend (WebSocket at /ws/chat, files at /files).
# Only needed for `npm run dev`, where the Vite dev server and the backend run on different
# ports/origins. Leave unset for a production build served by the FastAPI app itself
# (`npm run build` into UI/dist, then run the backend) - same origin, no config needed.
VITE_BACKEND_URL="http://127.0.0.1:5000"
